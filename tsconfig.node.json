{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ],
  "compilerOptions": {
    "composite": true,  // ← ЭТО ДОЛЖНО БЫТЬ ЗДЕСЬ
    "incremental": true,  // ← ИЛИ ЭТО (можно оба)
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}